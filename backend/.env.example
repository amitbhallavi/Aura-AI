# ============================================================
# BACKEND ENVIRONMENT VARIABLES — .env.example
# Copy this to .env and fill in your actual values
# NEVER commit .env to GitHub
# ============================================================

# Server Configuration
PORT=8080
NODE_ENV=development

# Frontend URL (CORS origin) — change for production
# Production: https://yourfrontend.vercel.app
FRONTEND_URL=http://localhost:5173

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# PostgreSQL (Supabase, Railway, Render, or local)
# Format: postgresql://user:password@host:port/database
PG_HOST=your-postgres-host.com
PG_PORT=5432
PG_DATABASE=your_database_name
PG_USER=your_postgres_user
PG_PASSWORD=your_postgres_password_here

# MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?appName=cluster
MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/aura_ai?appName=cluster

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================

# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be 32+ random characters, NOT based on personal info
JWT_SECRET=your-random-32-character-secret-key-here-min-32-chars

# Encryption key for phone config (same format as above)
ENCRYPTION_KEY=your-random-32-character-encryption-key-here

# ============================================================
# AI PROVIDERS
# ============================================================

# Gemini (Google AI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq (Fast open-source models)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# GOOGLE SERVICES
# ============================================================

# Google Cloud Project (for Speech-to-Text, Text-to-Speech)
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_APPLICATION_CREDENTIALS=./aura-service.json
GOOGLE_STT_ENABLED=true
GOOGLE_TTS_ENABLED=true

# Google APIs (Maps, Translate)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Google OAuth (for Gmail, Calendar, Google Sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://your-backend-url/api/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://your-backend-url/api/auth/google/callback
CALENDAR_REDIRECT_URI=https://your-backend-url/api/calendar/callback

# ============================================================
# COMMUNICATION SERVICES
# ============================================================

# Twilio (Calls, SMS, WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VERIFY_SID=your-verify-service-id

# SendGrid (Email with OTP)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=your-email@example.com

# ============================================================
# PAYMENT PROCESSING
# ============================================================

# Razorpay (Payment gateway - India)
# Test Mode: Get from https://dashboard.razorpay.com (in test mode)
# Production: Get from https://dashboard.razorpay.com (switch to live mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-never-expose-this

# ============================================================
# EXTERNAL SERVICES
# ============================================================

# Backend Public URL (for Twilio callbacks, webhooks)
# Development: Use ngrok (ngrok http 8080) and update this
# Production: Your Render backend URL
API_URL=https://your-backend-url.onrender.com/api
TWIML_URL=https://your-backend-url.onrender.com/twiml

# ============================================================
# VOICE CONFIGURATION
# ============================================================

VOICE_PROVIDER=google
VOICE_FALLBACK_PROVIDER=browser
VOICE_MAX_AUDIO_SECONDS=60
VOICE_TRANSCRIPT_RETENTION_DAYS=7

# ============================================================
# RATE LIMITING (OPTIONAL)
# ============================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=600
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_AI_MAX=120
RATE_LIMIT_PAYMENT_MAX=60
RATE_LIMIT_VOICE_MAX=30
