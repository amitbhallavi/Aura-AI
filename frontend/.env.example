# ============================================================
# FRONTEND ENVIRONMENT VARIABLES — .env.example
# Copy this to .env and fill in your actual values
# IMPORTANT: Only VITE_* public variables are exposed to browser
# NEVER put secret keys here
# ============================================================

# Backend API URL
# Development: Leave empty (Vite proxy handles it)
# Production: Set to your Render backend URL (with /api at end)
# Example Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Razorpay - PUBLIC KEY ONLY (not secret)
# Get from: https://dashboard.razorpay.com/app/keys
# Key ID is safe to expose (public), but never Key Secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Socket.io URL (optional, for production)
# Leave empty to use same origin
VITE_SOCKET_URL=

# ============================================================
# NOTES:
# - VITE_ prefix makes variables available in browser via import.meta.env
# - All other variables are build-time only, not in browser
# - Never put API keys, passwords, tokens here
# - Backend secrets must be in backend .env only
# ============================================================
